{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.easyfootings.com.au" }],
      "destination": "https://easyfootings.com.au/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.easyfootings.com.au" }],
      "destination": "https://easyfootings.com.au/:path*",
      "statusCode": 301
    },
    {
      "source": "/collections/all",
      "destination": "/products/stumprite.html",
      "statusCode": 301
    },
    {
      "source": "/collections/all/",
      "destination": "/products/stumprite.html",
      "statusCode": 301
    },
    {
      "source": "/pages/contact",
      "destination": "/#contact",
      "statusCode": 301
    },
    {
      "source": "/pages/contact/",
      "destination": "/#contact",
      "statusCode": 301
    },
    {
      "source": "/products/rapidstump-footings",
      "destination": "/products/rapidstump.html",
      "statusCode": 301
    },
    {
      "source": "/products/rapidstump-footings/",
      "destination": "/products/rapidstump.html",
      "statusCode": 301
    },
    {
      "source": "/pages/services",
      "destination": "/#services",
      "statusCode": 301
    },
    {
      "source": "/pages/services/",
      "destination": "/#services",
      "statusCode": 301
    },
    {
      "source": "/blogs/news",
      "destination": "/blog/",
      "statusCode": 301
    },
    {
      "source": "/blogs/news/",
      "destination": "/blog/",
      "statusCode": 301
    },
    {
      "source": "/collections/frontpage",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/collections/frontpage/",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/collections/frontpage.atom",
      "destination": "/blog/",
      "statusCode": 301
    },
    {
      "source": "/collections/frontpage.atom/",
      "destination": "/blog/",
      "statusCode": 301
    }
  ]
}
